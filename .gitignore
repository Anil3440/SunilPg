# Root .gitignore for Sunil PG Monorepo

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Production build outputs
frontend/dist/
frontend/dist-ssr/

# Environment variables & secrets (CRITICAL)
.env
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

